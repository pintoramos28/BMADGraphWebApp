{
  "name": "bmad-graph-web-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "guard:runtime": "node ./scripts/enforce-node-runtime.mjs",
    "preinstall": "node ./scripts/enforce-node-runtime.mjs install",
    "predev": "node ./scripts/enforce-node-runtime.mjs dev",
    "prebuild": "node ./scripts/enforce-node-runtime.mjs build",
    "prepreview": "node ./scripts/enforce-node-runtime.mjs preview",
    "prepreview:shell": "node ./scripts/enforce-node-runtime.mjs preview:shell",
    "prelint": "node ./scripts/enforce-node-runtime.mjs lint",
    "pretypecheck": "node ./scripts/enforce-node-runtime.mjs typecheck",
    "pretest": "node ./scripts/enforce-node-runtime.mjs test",
    "pretest:watch": "node ./scripts/enforce-node-runtime.mjs test:watch",
    "pretest:e2e": "node ./scripts/enforce-node-runtime.mjs test:e2e",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:shell": "node ./scripts/shell-delivery-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
