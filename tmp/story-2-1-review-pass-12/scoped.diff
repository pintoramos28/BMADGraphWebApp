+  export interface ParseError {
+    message: string;
+  }
+
+  export interface ParseMeta {
+    delimiter?: string;
+  }
+
+  export interface ParseResult<T> {
+    data: T[];
+    errors: ParseError[];
+    meta: ParseMeta;
+  }
+
+  export interface ParseStepResult<T> {
+    data: T;
+    errors: ParseError[];
+    meta: ParseMeta;
+  }
+
+  export interface Parser {
+    abort(): void;
+  }
+
+  export interface ParseConfig {
+    delimiter?: string;
