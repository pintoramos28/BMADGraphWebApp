{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmad.local/schemas/story-loop/orchestrator-report.schema.json",
  "title": "BMAD Story Loop Orchestrator Worker Report",
  "oneOf": [
    { "$ref": "#/$defs/implementation_report" },
    { "$ref": "#/$defs/review_report" }
  ],
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["backlog", "ready-for-dev", "in-progress", "review", "done", "no-sprint-tracking", "unknown"]
    },
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "string_array": {
      "type": "array",
      "items": { "type": "string" }
    },
    "finding_source": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["blind", "edge", "runtime", "acceptance", "review-worker"] }
    },
    "gating_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "title", "detail", "source", "location", "action_state"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/finding_source" },
        "location": { "type": ["string", "null"] },
        "action_state": { "type": "string", "const": "action_item" }
      }
    },
    "p3_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "title", "detail", "source", "location", "action_state", "p3_rationale", "disposition_reason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "const": "P3" },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/finding_source" },
        "location": { "type": ["string", "null"] },
        "action_state": { "type": "string", "enum": ["action_item", "deferred"] },
        "p3_rationale": { "type": "string", "minLength": 1 },
        "disposition_reason": { "type": "string", "minLength": 1 }
      }
    },
    "decision_needed_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "detail", "options", "location"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "location": { "type": ["string", "null"] }
      }
    },
    "fanout_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blind", "edge", "runtime", "acceptance"],
      "properties": {
        "blind": { "type": "string", "enum": ["completed", "failed", "skipped", "blocked"] },
        "edge": { "type": "string", "enum": ["completed", "failed", "skipped", "blocked"] },
        "runtime": { "type": "string", "enum": ["completed", "failed", "skipped", "blocked"] },
        "acceptance": { "type": "string", "enum": ["completed", "failed", "skipped", "blocked"] }
      }
    },
    "implementation_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "worker_type",
        "result",
        "story_key",
        "story_path",
        "story_status_after",
        "sprint_status_after",
        "validation_commands_run",
        "changed_files",
        "blocker",
        "summary"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "worker_type": { "type": "string", "const": "implementation" },
        "result": { "type": "string", "enum": ["completed", "blocked", "failed"] },
        "story_key": { "$ref": "#/$defs/non_empty_string" },
        "story_path": { "$ref": "#/$defs/non_empty_string" },
        "story_status_after": { "$ref": "#/$defs/status" },
        "sprint_status_after": { "$ref": "#/$defs/status" },
        "validation_commands_run": { "$ref": "#/$defs/string_array" },
        "changed_files": { "$ref": "#/$defs/string_array" },
        "blocker": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "review_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "worker_type",
        "result",
        "story_key",
        "story_path",
        "story_status_after",
        "sprint_status_after",
        "fanout_layers",
        "gating_findings",
        "p3_findings",
        "decision_needed",
        "deferred_work_location",
        "summary"
      ],
      "properties": {
        "schema_version": { "type": "string", "const": "1.0" },
        "worker_type": { "type": "string", "const": "review" },
        "result": { "type": "string", "enum": ["clean", "p3_only", "changes_requested", "decision_needed", "blocked", "failed"] },
        "story_key": { "$ref": "#/$defs/non_empty_string" },
        "story_path": { "$ref": "#/$defs/non_empty_string" },
        "story_status_after": { "$ref": "#/$defs/status" },
        "sprint_status_after": { "$ref": "#/$defs/status" },
        "fanout_layers": { "$ref": "#/$defs/fanout_layers" },
        "gating_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/gating_finding" }
        },
        "p3_findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/p3_finding" }
        },
        "decision_needed": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_needed_item" }
        },
        "deferred_work_location": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    }
  }
}
